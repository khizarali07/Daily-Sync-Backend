# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/dailysync?schema=public

# JWT Secret
JWT_SECRET=change-this-in-production

# Server
PORT=5000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Email Configuration (SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=your-email@example.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# AI provider switch: gemini | local
AI_PROVIDER=gemini

# Gemini settings (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Local AI Engine using llama-cpp-python and Ngrok
LOCAL_AI_URL=https://kathlyn-unsyndicated-grandiosely.ngrok-free.dev
