// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String         @id @default(uuid())
  email                     String         @unique
  password                  String
  name                      String
  emailVerified             Boolean        @default(false)
  otp                       String?
  otpExpiry                 DateTime?
  resetPasswordToken        String?        @unique
  resetPasswordTokenExpiry  DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  taskTemplates             TaskTemplate[]
  taskInstances             TaskInstance[]
  dailyLogs                 DailyLog[]
  healthMetrics             HealthMetrics[]
  nutritionTargets          NutritionTarget[]
  mealLogs                  MealLog[]
  workouts                  Workout[]

  @@map("users")
}

model TaskTemplate {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  startTime   String // Format: "HH:MM" (e.g., "06:00")
  endTime     String // Format: "HH:MM" (e.g., "07:00")
  category    String? // e.g., "Prayer", "Workout", "Study"
  description String?
  isRecurring Boolean        @default(true)
  daysOfWeek  String         @default("") // Comma-separated: "MON,TUE,WED" - empty means all days
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  instances   TaskInstance[]

  @@map("task_templates")
}

model TaskInstance {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String?
  template     TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date         DateTime
  name         String
  startTime    String
  endTime      String
  category     String?
  description  String?
  isCompleted  Boolean       @default(false)
  completedAt  DateTime?
  notes        String? // User's notes when completing the task
  missedReason String? // Why the task was missed (M5: interrogation)
  imageUrl     String? // Image URL for AI analysis (food/workout photos)
  aiData       String? // AI analysis results as JSON string (calories, macros, exercise data)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, date])
  @@map("task_instances")
}

model DailyLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  summary        String?  // AI-generated diary entry
  aiPrompt       String?  // The prompt used to generate the summary
  totalTasks     Int?     // Total tasks for the day
  completedTasks Int?     // Number completed
  missedTasks    Int?     // Number missed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_logs")
}

model HealthMetrics {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime

  // Sleep Data
  sleepDuration   Float?   // Hours of sleep
  sleepQuality    String?  // "poor", "fair", "good", "excellent"
  bedtime         String?  // Format: "HH:MM"
  wakeTime        String?  // Format: "HH:MM"
  
  // Heart Rate
  restingHeartRate Int?    // BPM - Resting heart rate
  avgHeartRate     Int?    // BPM - Average heart rate
  maxHeartRate     Int?    // BPM - Maximum heart rate
  minHeartRate     Int?    // BPM - Minimum heart rate
  
  // Activity Data
  steps           Int?     // Daily steps
  caloriesBurned  Int?     // Total calories burned
  activeMinutes   Int?     // Minutes of activity
  distance        Float?   // Distance in km
  
  // Weight/Body
  weight          Float?   // Weight in kg
  bodyFat         Float?   // Body fat percentage
  bmi             Float?   // Body Mass Index
  
  // Nutrition (calculated from AI food analysis)
  caloriesConsumed Int?    // Total calories consumed
  proteinGrams     Int?    // Protein in grams
  carbsGrams       Int?    // Carbs in grams
  fatGrams         Int?    // Fat in grams
  fiberGrams       Float?  // Fiber in grams
  waterIntake      Float?  // Water intake in liters
  
  // Vitamins
  vitAMcg          Float?
  vitCMg           Float?
  vitDIu           Float?
  vitEMg           Float?
  vitKMcg          Float?
  vitB1Mg          Float?
  vitB2Mg          Float?
  vitB3Mg          Float?
  vitB6Mg          Float?
  vitB7Mcg         Float?
  vitB9Mcg         Float?
  vitB12Mcg        Float?

  // Minerals & Others
  calciumMg        Float?
  magnesiumMg      Float?
  potassiumMg      Float?
  sodiumMg         Float?
  ironMg           Float?
  zincMg           Float?
  iodineMcg        Float?
  seleniumMcg      Float?
  copperMg         Float?
  phosphorusMg     Float?
  omega3G          Float?
  omega6G          Float?
  cholineMg        Float?
  manganeseMg      Float?
  fluorideMg       Float?
  chromiumMcg      Float?
  molybdenumMcg    Float?
  chlorideMg       Float?
  
  // Mood and Energy
  moodScore       Int?     // 1-10 mood scale
  energyLevel     Int?     // 1-10 energy scale
  stressLevel     Int?     // 1-10 stress scale
  
  // Source tracking
  source          String?  // "manual", "google_fit", "apple_health", "fitbit"
  rawData         String?  // Store raw API response for debugging as JSON string

  // Workout
  workoutId       String?
  workout         Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("health_metrics")
}

model Workout {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  exercises       Json     // Array of exercises
  estimatedCalories Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  healthMetrics   HealthMetrics[]

  @@map("workouts")
}

model NutritionTarget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nutrient  String   // e.g., "Protein", "Vit C"
  min       Float?
  max       Float?
  target    Float?
  unit      String

  @@unique([userId, nutrient])
  @@map("nutrition_targets")
}

model MealLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime // The day this meal belongs to
  mealType        String   // "Breakfast", "Lunch", "Dinner", "Snack"
  name            String?  // Description or name of the meal
  summary         String?  // AI Summary or manual notes
  
  // Basic Macros
  calories        Int?
  proteinGrams    Int?
  carbsGrams      Int?
  fatGrams        Int?
  fiberGrams      Float?
  waterIntake     Float?

  // Vitamins
  vitAMcg         Float?
  vitCMg          Float?
  vitDIu          Float?
  vitEMg          Float?
  vitKMcg         Float?
  vitB1Mg         Float?
  vitB2Mg         Float?
  vitB3Mg         Float?
  vitB6Mg         Float?
  vitB7Mcg        Float?
  vitB9Mcg        Float?
  vitB12Mcg       Float?

  // Minerals & Others
  calciumMg       Float?
  magnesiumMg     Float?
  potassiumMg     Float?
  sodiumMg        Float?
  ironMg          Float?
  zincMg          Float?
  iodineMcg       Float?
  seleniumMcg     Float?
  copperMg        Float?
  phosphorusMg    Float?
  omega3G         Float?
  omega6G         Float?
  cholineMg       Float?
  manganeseMg     Float?
  fluorideMg      Float?
  chromiumMcg     Float?
  molybdenumMcg   Float?
  chlorideMg      Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@map("meal_logs")
}
